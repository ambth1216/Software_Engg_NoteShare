# Database Connection (Local MongoDB or MongoDB Atlas Cloud URI)
MONGO_URI=mongodb://localhost:27017/noteshare
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/noteshare?retryWrites=true&w=majority

# App Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# AWS S3 Storage Configuration (Set USE_S3=true to use AWS S3 for uploaded files)
USE_S3=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name